# Copy to .env and fill in. NEVER commit the real .env.
# All secrets are read from the environment only (spec §9).

# --- Database ---
# SQLite file path (relative to project root or absolute).
TRADEER_DB_PATH=data/tradeer.db

# --- Risk thresholds (Phase 1) ---
# Warn when a single position exceeds this share of the portfolio (0-1).
TRADEER_MAX_POSITION_PCT=0.25
# Warn when a single sector exceeds this share of the portfolio (0-1).
TRADEER_MAX_SECTOR_PCT=0.40
# Warn when drawdown from peak exceeds this magnitude (0-1, positive number).
TRADEER_MAX_DRAWDOWN_PCT=0.20

# --- Market data (Phase 1 uses yfinance, no key needed) ---
# ALPHA_VANTAGE_API_KEY=

# --- Information layer (Phase 2) ---
# Finnhub free tier: news + earnings calendar. Without it news/earnings are skipped.
# FINNHUB_API_KEY=
# Number of days of company news to pull / how far ahead to watch earnings.
TRADEER_NEWS_LOOKBACK_DAYS=7
TRADEER_EARNINGS_LOOKAHEAD_DAYS=14
TRADEER_EARNINGS_ALERT_DAYS=5
# SEC EDGAR requires a descriptive User-Agent with real contact info.
TRADEER_SEC_USER_AGENT=tradeer/0.1 (your-email@example.com)

# --- Telegram alerts (Phase 2) ---
# Without both, alerts are logged to the DB but not pushed.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Phase 4 — Claude analytics layer ---
# Enables the natural-language analysis, digest and deep report.
# Without it the numeric analytics still work; Claude sections are skipped.
# ANTHROPIC_API_KEY=
# Optional overrides (non-secret):
# TRADEER_CLAUDE_MODEL=claude-opus-4-7
# TRADEER_CLAUDE_MAX_TOKENS=8000

# --- Broker (Phase 3, read-only only) ---
# TRADERNET_PUBLIC_KEY=
# TRADERNET_PRIVATE_KEY=
